# ── MailGuard Pro — Environment Configuration ─────────────────────────────────
# Copy this file to .env and fill in your values before running docker compose up

# ── License ───────────────────────────────────────────────────────────────────
MAILGUARD_LICENSE_KEY=your-license-key-here

# Database (required) - password for the bundled PostgreSQL database
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Network (optional) - port MailGuard listens on; change if 8000 is in use
PORT=8000

# ── Microsoft 365 ─────────────────────────────────────────────────────────────
SEED_TENANT_NAME=Your Org Name
SEED_TENANT_DOMAIN=yourdomain.com
SEED_TENANT_ID=your-m365-tenant-id
SEED_CLIENT_ID=your-azure-app-client-id
SEED_CLIENT_SECRET=your-azure-app-client-secret

# ── Google Workspace (optional) ───────────────────────────────────────────────
SEED_GWS_REFRESH_TOKEN=

# ── Auth ──────────────────────────────────────────────────────────────────────
# AUTH_MODE: local (password login) | idp (M365/GWS SSO)
AUTH_MODE=local
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Multi-tenancy (MSP use) ───────────────────────────────────────────────────
MULTI_TENANT_MODE=false

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-random-64-char-string
ENCRYPTION_KEY=generate-a-random-base64-encoded-32-byte-key

# ── Threat intelligence (optional) ───────────────────────────────────────────
ABUSEIPDB_API_KEY=
VT_API_KEY=
URLHAUS_AUTH_KEY=
SPAMHAUS_USERNAME=
SPAMHAUS_KEY=
# Proofpoint Emerging Threats — powers ET Intelligence enrichment in Domain Exposure
# Get your key at: https://www.proofpoint.com/us/threat-intelligence
ET_API_KEY=

# ── AI features (optional) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Lookalike domain monitoring (optional) ────────────────────────────────────
AZURE_LOOKALIKE_BLOB_CONNECTION_STRING=
